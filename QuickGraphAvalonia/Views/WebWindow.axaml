<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:QuickGraphAvalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="QuickGraphAvalonia.Views.WebWindow"
        x:DataType="vm:WebViewModel"
        Loaded="LoadHandler"
        Title="WebWindow">

        <Design.DataContext>
                <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
                <vm:WebViewModel />
        </Design.DataContext>
    
    <DockPanel>
        
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Navigation">
                <MenuItem Header="_Show Print UI..." 
                          Command="{Binding ShowPrintUserInterfaceCommand}"
                          CommandParameter="{Binding  #WebView}"/>
                <Separator />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Copy">
                    <!--<MenuItem.Icon>
                        <PathIcon Data="{StaticResource copy_regular}"/>
                    </MenuItem.Icon>-->
                </MenuItem>
                <MenuItem Header="Paste">
                    <!--<MenuItem.Icon>
                        <PathIcon Data="{StaticResource clipboard_paste_regular}"/>
                    </MenuItem.Icon>-->
                </MenuItem>
            </MenuItem>
        </Menu>
        
        <NativeWebView x:Name="WebView" 
                       NavigationCompleted="NativeWebView_OnNavigationCompleted"
                       WebMessageReceived="NativeWebView_OnWebMessageReceived"
                       Source="https://avaloniaui.net">
            
        </NativeWebView>
    </DockPanel>
    
</Window>
